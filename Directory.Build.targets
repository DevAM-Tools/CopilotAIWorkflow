<Project>
  <PropertyGroup>
    <!-- netstandard2.0+ and .NET Core App consumers (incl. source generators). -->
    <_CscConsumerTargetFramework Condition="'$(_CscConsumerTargetFramework)' == '' and '$(TargetFrameworkIdentifier)' == '.NETStandard' and $([MSBuild]::VersionGreaterThanOrEquals($([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')), '2.0'))">true</_CscConsumerTargetFramework>
    <_CscConsumerTargetFramework Condition="'$(_CscConsumerTargetFramework)' == '' and '$(TargetFrameworkIdentifier)' == '.NETCoreApp'">true</_CscConsumerTargetFramework>
    <ApplyCSharpStyleChecker Condition="'$(ApplyCSharpStyleChecker)' == '' and '$(_CscConsumerTargetFramework)' == 'true' and '$(MSBuildProjectName)' != 'CSharpStyleChecker' and '$(MSBuildProjectName)' != 'CSharpStyleChecker.Tests' and '$(MSBuildProjectName)' != 'ExitPoints' and '$(MSBuildProjectName)' != 'ExitPoints.Tests'">true</ApplyCSharpStyleChecker>
    <CSharpStyleCheckerProjectPath>$(MSBuildThisFileDirectory)src\CSharpStyleChecker\CSharpStyleChecker.csproj</CSharpStyleCheckerProjectPath>
  </PropertyGroup>
  <!--
    One ProjectReference builds the analyzer once and passes CSharpStyleChecker.dll to the compiler.
    A nested MSBuild task before CoreCompile would repeat that build for every consumer.
  -->
  <ItemGroup Condition="'$(ApplyCSharpStyleChecker)' == 'true'">
    <ProjectReference
      Include="$(CSharpStyleCheckerProjectPath)"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all" />
  </ItemGroup>
  <!--
    ProjectReference OutputItemType=Analyzer passes only CSharpStyleChecker.dll.
    After the checker project builds, ExitPoints.dll sits beside it; add that
    path as an Analyzer so the load context finds the dependency without a
    nested MSBuild rebuild of the checker.
  -->
  <Target
    Name="AddExitPointsAnalyzerDependency"
    Condition="'$(ApplyCSharpStyleChecker)' == 'true'"
    DependsOnTargets="ResolveProjectReferences"
    BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_ExitPointsAnalyzerPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\CSharpStyleChecker\bin\$(Configuration)\netstandard2.0\ExitPoints.dll'))</_ExitPointsAnalyzerPath>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(_ExitPointsAnalyzerPath)')">
      <Analyzer Include="$(_ExitPointsAnalyzerPath)" />
    </ItemGroup>
  </Target>
  <PropertyGroup Condition="'$(PackageId)' != ''">
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <PackageOutputPath Condition="'$(Configuration)' == 'Release'">$(MSBuildThisFileDirectory)artifacts\</PackageOutputPath>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
    <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">https://github.com/DevAM/CopilotAIWorkflow</PackageProjectUrl>
    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/DevAM/CopilotAIWorkflow</RepositoryUrl>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PackageId)' == ''">
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(PackageId)' != ''">
    <None Include="$(MSBuildThisFileDirectory)PACKAGE_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
