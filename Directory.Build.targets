<Project>
  <PropertyGroup>
    <!-- netstandard2.0+ and .NET Core App consumers (incl. source generators). -->
    <_CsvConsumerTargetFramework Condition="'$(_CsvConsumerTargetFramework)' == '' and '$(TargetFrameworkIdentifier)' == '.NETStandard' and $([MSBuild]::VersionGreaterThanOrEquals($([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')), '2.0'))">true</_CsvConsumerTargetFramework>
    <_CsvConsumerTargetFramework Condition="'$(_CsvConsumerTargetFramework)' == '' and '$(TargetFrameworkIdentifier)' == '.NETCoreApp'">true</_CsvConsumerTargetFramework>
    <ApplyCSharpStyleValidator Condition="'$(ApplyCSharpStyleValidator)' == '' and '$(_CsvConsumerTargetFramework)' == 'true' and '$(MSBuildProjectName)' != 'CSharpStyleValidator' and '$(MSBuildProjectName)' != 'CSharpStyleValidator.Tests' and '$(MSBuildProjectName)' != 'ExitPoints' and '$(MSBuildProjectName)' != 'ExitPoints.Tests'">true</ApplyCSharpStyleValidator>
    <CSharpStyleValidatorProjectPath>$(MSBuildThisFileDirectory)src\CSharpStyleValidator\CSharpStyleValidator.csproj</CSharpStyleValidatorProjectPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(ApplyCSharpStyleValidator)' == 'true'">
    <ProjectReference
      Include="$(CSharpStyleValidatorProjectPath)"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Import
    Project="$(MSBuildThisFileDirectory)src\CSharpStyleValidator\build\CSharpStyleValidator.Local.targets"
    Condition="'$(ApplyCSharpStyleValidator)' == 'true'" />
  <PropertyGroup Condition="'$(PackageId)' != ''">
    <IsPackable>true</IsPackable>
    <DebugType Condition="'$(PackageId)' == 'CoverageGapAnalysis'">portable</DebugType>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <PackageOutputPath Condition="'$(Configuration)' == 'Release'">$(MSBuildThisFileDirectory)artifacts\</PackageOutputPath>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
    <IncludeSymbols Condition="'$(PackageId)' == 'CoverageGapAnalysis'">true</IncludeSymbols>
    <SymbolPackageFormat Condition="'$(PackageId)' == 'CoverageGapAnalysis'">snupkg</SymbolPackageFormat>
    <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">https://github.com/DevAM/CopilotAIWorkflow</PackageProjectUrl>
    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/DevAM/CopilotAIWorkflow</RepositoryUrl>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PackageId)' == ''">
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(PackageId)' != ''">
    <None Include="$(MSBuildThisFileDirectory)PACKAGE_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
