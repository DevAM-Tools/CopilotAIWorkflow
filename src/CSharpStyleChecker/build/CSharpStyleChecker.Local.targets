<Project>
  <!-- Transitive analyzer DLL for CSC006; consumers reference CSharpStyleChecker only. -->
  <PropertyGroup>
    <CSharpStyleCheckerProjectPath>$(MSBuildThisFileDirectory)..\CSharpStyleChecker.csproj</CSharpStyleCheckerProjectPath>
  </PropertyGroup>
  <ItemGroup>
    <Analyzer
      Include="$(MSBuildThisFileDirectory)..\..\ExitPoints\bin\$(Configuration)\netstandard2.0\ExitPoints.dll"
      Condition="Exists('$(MSBuildThisFileDirectory)..\..\ExitPoints\bin\$(Configuration)\netstandard2.0\ExitPoints.dll')" />
  </ItemGroup>
  <Target Name="EnsureCSharpStyleCheckerBuilt" BeforeTargets="CoreCompile" Condition="'$(IsPacking)' != 'true'">
    <MSBuild
      Projects="$(CSharpStyleCheckerProjectPath)"
      Targets="Build"
      Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0" />
  </Target>
</Project>
