<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CoverageGap.Tool</RootNamespace>
    <AssemblyName>CoverageGap.Tool</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>coveragegap</ToolCommandName>
    <PackageId>CoverageGap.Tool</PackageId>
    <Description>Agent-oriented coverage gap reports for branch and exit-point coverage.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CoverageGapAnalysis\CoverageGapAnalysis.csproj" />
    <ProjectReference Include="..\ExitPoints\ExitPoints.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CoverageGap.Tool.Tests" />
  </ItemGroup>
</Project>
